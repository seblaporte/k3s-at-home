{
  "uid": "trivy-image-updates",
  "title": "Trivy - Priorisation des mises à jour d'images",
  "description": "Aide à décider quelles images mettre à jour en premier, d'après les rapports de vulnérabilités Trivy Operator (CVE avec correctif disponible uniquement).",
  "tags": [
    "trivy",
    "security",
    "vulnerabilities",
    "updates"
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5m",
  "time": {
    "from": "now-14d",
    "to": "now"
  },
  "timezone": "browser",
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Trivy Operator Dashboard",
      "type": "link",
      "url": "/d/ycwPj724k",
      "icon": "dashboard",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(trivy_image_vulnerabilities, namespace)",
          "refId": "v"
        },
        "definition": "label_values(trivy_image_vulnerabilities, namespace)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "image",
        "label": "Image",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(trivy_image_vulnerabilities{namespace=~\"$namespace\"}, image_repository)",
          "refId": "v"
        },
        "definition": "label_values(trivy_image_vulnerabilities{namespace=~\"$namespace\"}, image_repository)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "severity",
        "label": "Sévérité (détail)",
        "type": "custom",
        "multi": true,
        "includeAll": false,
        "query": "Critical,High,Medium,Low,Unknown",
        "hide": 0,
        "current": {
          "selected": true,
          "text": [
            "Critical",
            "High"
          ],
          "value": [
            "Critical",
            "High"
          ]
        },
        "options": [
          {
            "selected": true,
            "text": "Critical",
            "value": "Critical"
          },
          {
            "selected": true,
            "text": "High",
            "value": "High"
          },
          {
            "selected": false,
            "text": "Medium",
            "value": "Medium"
          },
          {
            "selected": false,
            "text": "Low",
            "value": "Low"
          },
          {
            "selected": false,
            "text": "Unknown",
            "value": "Unknown"
          }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Images scannées",
      "description": "Images distinctes (namespace + repository + tag) scannées par Trivy.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "count(count by (namespace,image_repository,image_tag)(trivy_image_info{namespace=~\"$namespace\",image_repository=~\"$image\"}))",
          "refId": "A",
          "format": "time_series",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "0"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
    {
