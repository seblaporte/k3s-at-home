          },
          "expr": "topk(20, count by (vuln_id,severity,resource)(count by (vuln_id,severity,resource,namespace,image_repository,image_tag)(trivy_vulnerability_id{severity=~\"Critical|High\",namespace=~\"$namespace\",image_repository=~\"$image\"})))",
